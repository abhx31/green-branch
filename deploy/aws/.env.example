# Copy to /home/ubuntu/greenbranch/.env on the instance (never commit the real file).

# Public hostname for the API; its DNS A record must point at the instance's Elastic IP
API_DOMAIN=api.example.com

# server-ai (prefix SERVER_)
SERVER_API_KEY=change-me-long-random
SERVER_GROQ_API_KEY=gsk_...
SERVER_LLM_MODEL=openai/gpt-oss-120b
SERVER_LLM_MAX_TOKENS=8192
SERVER_MAX_ITERATIONS=5

# server-ec2 (prefix EC2_AGENT_); server-ai is given the same key automatically
EC2_AGENT_API_KEY=change-me-another-long-random
